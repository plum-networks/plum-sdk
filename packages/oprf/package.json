{
  "name": "@plumbox/oprf",
  "version": "0.1.0",
  "description": "Zero-knowledge box discovery for Plum: find a user's box from (email, password) via an OPRF, without the relay learning the email, the password, or which box.",
  "license": "MIT",
  "keywords": [
    "plum",
    "plumbox",
    "plum-box",
    "oprf",
    "voprf",
    "ristretto255",
    "zero-knowledge",
    "discovery",
    "privacy"
  ],
  "homepage": "https://github.com/plum-networks/plum-sdk/tree/main/packages/oprf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plum-networks/plum-sdk.git",
    "directory": "packages/oprf"
  },
  "bugs": {
    "url": "https://github.com/plum-networks/plum-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "^0.7.13"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
